# ZOYI ZT703S/ZT706S PC GUI - macOS build, plain make + clang++ against Qt 6.
#
#   brew install qt                 (or an official Qt install: QT_DIR=<Qt>/6.x/macos)
#   make -f Makefile.mac            build the binary
#   make -f Makefile.mac app        build ZoyiGUI.app (macdeployqt bundles Qt)
#   make -f Makefile.mac zip        ZoyiGUI.zip, ready to hand out
#
# BUILD defaults to a folder under ~/Library/Caches. Override with BUILD=<dir>.
#
# Qt comes in as frameworks (dynamic). Homebrew's are built for the macOS they
# were bottled on, which then is the app's minimum too; the official Qt
# packages (QT_DIR) run on older systems, so releases are built with those.
# The app is ad hoc signed.
# Another Mac shows a Gatekeeper warning for it: right-click, Open, once.
# A Developer ID signature plus notarization needs a paid Apple account.

QT_DIR    ?=
ifeq ($(QT_DIR),)
QT_PREFIX := $(shell brew --prefix qt)
QT_BASE   := $(shell brew --prefix qtbase)
QT_FW     := $(QT_PREFIX)/lib
MOC       := $(QT_BASE)/share/qt/libexec/moc
MACDEPLOY := $(QT_PREFIX)/bin/macdeployqt
else
QT_FW     := $(QT_DIR)/lib
MOC       := $(QT_DIR)/libexec/moc
MACDEPLOY := $(QT_DIR)/bin/macdeployqt
endif

BUILD  ?= $(HOME)/Library/Caches/zoyi_gui-build
TARGET := $(BUILD)/zoyi_gui
APP    := $(BUILD)/ZoyiGUI.app

# Qt headers come through the frameworks. The C++ headers come from the SDK, not
# the Command Line Tools folder, which can hold a stale copy.
# The sources include <QWidget>, not <QtWidgets/QWidget>, so each framework's
# Headers folder goes on the include path. -isystem keeps warnings out of Qt.
QT_INCS   := $(foreach m,QtCore QtGui QtWidgets QtSerialPort,-isystem $(QT_FW)/$(m).framework/Headers)
SDK       := $(shell xcrun --show-sdk-path)
# The oldest macOS every bundled Qt framework runs on (the highest of their
# LC_BUILD_VERSION minos), so the app states it instead of failing to load.
QT_MODS   := QtCore QtGui QtWidgets QtSerialPort
MACOS_MIN := $(or $(shell for f in $(QT_MODS); do otool -l $(QT_FW)/$$f.framework/$$f | awk '/minos/ {print $$2; exit}'; done | sort -t. -k1,1n -k2,2n | tail -1),12.0)
CXX       := clang++
CXXFLAGS  := -std=c++17 -O2 -g -Wall -Wextra -mmacosx-version-min=$(MACOS_MIN) \
             -nostdinc++ -isystem $(SDK)/usr/include/c++/v1 \
             -DQT_NO_DEBUG -DQT_CORE_LIB -DQT_GUI_LIB -DQT_WIDGETS_LIB \
             -DQT_SERIALPORT_LIB \
             -F$(QT_FW) $(QT_INCS) -I.
LDFLAGS   := -mmacosx-version-min=$(MACOS_MIN) -F$(QT_FW) \
             -framework QtWidgets -framework QtGui -framework QtCore \
             -framework QtSerialPort \
             -Wl,-rpath,$(QT_FW)

SRCS := main.cpp $(wildcard core/*.cpp) $(wildcard ui/*.cpp)
OBJS := $(patsubst %.cpp,$(BUILD)/%.o,$(SRCS))

MOC_HEADERS := core/scpiclient.h core/framepump.h ui/mainwindow.h ui/waveview.h \
               ui/overview.h ui/controldock.h ui/measbar.h ui/dmmpanel.h ui/genpanel.h
MOC_OBJS    := $(patsubst %.h,$(BUILD)/moc_%.o,$(MOC_HEADERS))

vpath %.h core ui .

all: $(TARGET)

$(TARGET): $(OBJS) $(MOC_OBJS)
	@mkdir -p $(dir $@)
	$(CXX) -o $@ $(OBJS) $(MOC_OBJS) $(LDFLAGS)

$(BUILD)/%.o: %.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

$(BUILD)/moc_%.cpp: %.h
	@mkdir -p $(dir $@)
	$(MOC) -F$(QT_FW) $(subst -isystem,-I,$(QT_INCS)) -I. $< -o $@

$(BUILD)/moc_%.o: $(BUILD)/moc_%.cpp
	@mkdir -p $(dir $@)
	$(CXX) $(CXXFLAGS) -MMD -MP -c $< -o $@

# ZoyiGUI.app: Contents/MacOS/zoyi_gui + Info.plist, then macdeployqt copies the
# Qt frameworks and the cocoa platform plugin in and fixes the load paths.
app: $(TARGET) Info.plist.in
	rm -rf $(APP)
	mkdir -p $(APP)/Contents/MacOS $(APP)/Contents/Resources
	cp $(TARGET) $(APP)/Contents/MacOS/zoyi_gui
	sed 's/@MACOS_MIN@/$(MACOS_MIN)/' Info.plist.in > $(APP)/Contents/Info.plist
	$(MACDEPLOY) $(APP)
	codesign --force --deep --sign - $(APP)

zip: app
	cd $(BUILD) && rm -f ZoyiGUI.zip && ditto -c -k --keepParent --norsrc ZoyiGUI.app ZoyiGUI.zip
	@echo $(BUILD)/ZoyiGUI.zip

clean:
	rm -rf $(BUILD)

.SECONDARY:
# Moc objects get a .d too: see the note in Makefile.
-include $(OBJS:.o=.d) $(MOC_OBJS:.o=.d)

.PHONY: all app zip clean
